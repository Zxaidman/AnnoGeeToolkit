<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AnonGee · Bridge Listener"
        Height="440" Width="620"
        MinHeight="320" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#FFF4F4F6"
        UseLayoutRounding="True"
        FontFamily="JetBrains Mono, Inter, Segoe UI, Calibri">

    <!--
        Minimal on purpose. A TaskDialog says what was true at the instant it
        opened, which is the wrong shape for a thing whose entire job is to be
        watching: a job arriving thirty seconds later was invisible.

        Only the styles this window uses are inlined. No StaticResource on the
        root Window element itself — resolving one there fails, because the
        resources it would reference are being declared inside it.
    -->

    <Window.Resources>
        <ResourceDictionary>
            <Color x:Key="ColorVividRed">#FFE02020</Color>
            <Color x:Key="ColorCharcoalBlack">#FF141414</Color>
            <Color x:Key="ColorPureWhite">#FFFFFFFF</Color>
            <Color x:Key="ColorOffWhite">#FFF4F4F6</Color>
            <Color x:Key="ColorMidGrey">#FF6B7280</Color>
            <Color x:Key="ColorLightBorder">#FFE2E4EA</Color>
            <Color x:Key="ColorSuccessGreen">#FF16A34A</Color>
            <Color x:Key="ColorVividRedHover">#FFC41A1A</Color>
            <Color x:Key="ColorOffWhiteHover">#FFE8E8EC</Color>

            <SolidColorBrush x:Key="BrushVividRed"      Color="{StaticResource ColorVividRed}"/>
            <SolidColorBrush x:Key="BrushCharcoal"      Color="{StaticResource ColorCharcoalBlack}"/>
            <SolidColorBrush x:Key="BrushWhite"         Color="{StaticResource ColorPureWhite}"/>
            <SolidColorBrush x:Key="BrushOffWhite"      Color="{StaticResource ColorOffWhite}"/>
            <SolidColorBrush x:Key="BrushMidGrey"       Color="{StaticResource ColorMidGrey}"/>
            <SolidColorBrush x:Key="BrushBorder"        Color="{StaticResource ColorLightBorder}"/>
            <SolidColorBrush x:Key="BrushGreen"         Color="{StaticResource ColorSuccessGreen}"/>
            <SolidColorBrush x:Key="BrushVividRedHover" Color="{StaticResource ColorVividRedHover}"/>
            <SolidColorBrush x:Key="BrushGhostHover"    Color="{StaticResource ColorOffWhiteHover}"/>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BrushWhite}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="12"/>
            </Style>

            <Style x:Key="Muted" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource BrushMidGrey}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="ButtonPrimary" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BrushVividRed}"/>
                <Setter Property="Foreground" Value="{StaticResource BrushWhite}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="14,6"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{StaticResource BrushVividRedHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ButtonGhost" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource BrushMidGrey}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{StaticResource BrushGhostHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- state -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="Lamp" Grid.Column="0" Width="10" Height="10"
                         Margin="0,4,10,0" VerticalAlignment="Top"
                         Fill="{StaticResource BrushMidGrey}"/>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="StateText" Text="Stopped" FontSize="15"
                               Foreground="{StaticResource BrushCharcoal}"/>
                    <TextBlock x:Name="FolderText" Style="{StaticResource Muted}"
                               Margin="0,3,0,0" Text=""/>
                    <TextBlock x:Name="CommandsText" Style="{StaticResource Muted}"
                               Margin="0,6,0,0" Text=""/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Text="Jobs" Margin="2,14,0,6" FontSize="12"
                   Foreground="{StaticResource BrushMidGrey}"/>

        <!-- jobs. __slots__ + ArrayList + ItemsSource; INPC fails silently -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="JobsGrid"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      Background="{StaticResource BrushWhite}"
                      BorderThickness="0" RowHeight="24" FontSize="11"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalGridLinesBrush="{StaticResource BrushBorder}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Job" Width="150"
                                        Binding="{Binding JobId, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Command" Width="110"
                                        Binding="{Binding Command, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Status" Width="80"
                                        Binding="{Binding Status, Mode=OneWay}"/>
                    <DataGridTextColumn Header="What happened" Width="*"
                                        Binding="{Binding Summary, Mode=OneWay}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- actions -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="ToggleBtn" Content="Start watching"
                    Style="{StaticResource ButtonPrimary}"/>
            <TextBlock Grid.Column="1" x:Name="LastText" Style="{StaticResource Muted}"
                       Margin="14,0" VerticalAlignment="Center" Text=""/>
            <Button Grid.Column="2" x:Name="CloseBtn" Content="Close"
                    Style="{StaticResource ButtonGhost}"/>
        </Grid>
    </Grid>
</Window>
