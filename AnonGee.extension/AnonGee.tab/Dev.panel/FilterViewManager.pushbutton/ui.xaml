<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="AnonGee · Filter View Manager"
        Height="780" Width="1120"
        MinHeight="660" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#FFF4F4F6"
        UseLayoutRounding="True"
        FontFamily="JetBrains Mono, Source Serif 4, Inter, Segoe UI, Calibri">

    <Window.Resources>
        <ResourceDictionary>

            <!-- ═══ AnonGee BIM Tools — Inlined Theme v3.2 ═══
                 VERBATIM from Dev.panel/Testing.stack/Modeless.pushbutton/ui.xaml,
                 which is the sanctioned inline copy of Resources/*.xaml
                 (§12.3 strategy 2 / §12.7.B). Spliced by hand-free copy so it
                 cannot drift; this tool adds NO styles of its own — the
                 implicit ListBoxItem and ScrollBar styles already theme the
                 three lists, and everything else is a keyed style that block
                 already defines. -->

            <!-- ── Colors ── -->
            <Color x:Key="ColorVividRed">#FFE02020</Color>
            <Color x:Key="ColorCharcoalBlack">#FF141414</Color>
            <Color x:Key="ColorSilverSteel">#FFC0C8D8</Color>
            <Color x:Key="ColorPureWhite">#FFFFFFFF</Color>
            <Color x:Key="ColorOffWhite">#FFF4F4F6</Color>
            <Color x:Key="ColorMidGrey">#FF6B7280</Color>
            <Color x:Key="ColorLightBorder">#FFE2E4EA</Color>
            <Color x:Key="ColorSuccessGreen">#FF16A34A</Color>
            <Color x:Key="ColorErrorRed">#FFDC2626</Color>
            <Color x:Key="ColorVividRedHover">#FFC41A1A</Color>
            <Color x:Key="ColorVividRedPressed">#FFA81515</Color>
            <Color x:Key="ColorErrorRedHover">#FFB91C1C</Color>
            <Color x:Key="ColorErrorRedPressed">#FF991B1B</Color>
            <Color x:Key="ColorVividRed10">#1AE02020</Color>
            <Color x:Key="ColorOffWhiteHover">#FFE8E8EC</Color>

            <SolidColorBrush x:Key="BrushVividRed"            Color="{StaticResource ColorVividRed}"/>
            <SolidColorBrush x:Key="BrushCharcoalBlack"       Color="{StaticResource ColorCharcoalBlack}"/>
            <SolidColorBrush x:Key="BrushSilverSteel"         Color="{StaticResource ColorSilverSteel}"/>
            <SolidColorBrush x:Key="BrushPureWhite"           Color="{StaticResource ColorPureWhite}"/>
            <SolidColorBrush x:Key="BrushOffWhite"            Color="{StaticResource ColorOffWhite}"/>
            <SolidColorBrush x:Key="BrushMidGrey"             Color="{StaticResource ColorMidGrey}"/>
            <SolidColorBrush x:Key="BrushLightBorder"         Color="{StaticResource ColorLightBorder}"/>
            <SolidColorBrush x:Key="BrushSuccessGreen"        Color="{StaticResource ColorSuccessGreen}"/>
            <SolidColorBrush x:Key="BrushErrorRed"            Color="{StaticResource ColorErrorRed}"/>
            <SolidColorBrush x:Key="BrushVividRedHover"       Color="{StaticResource ColorVividRedHover}"/>
            <SolidColorBrush x:Key="BrushVividRedPressed"     Color="{StaticResource ColorVividRedPressed}"/>
            <SolidColorBrush x:Key="BrushErrorRedHover"       Color="{StaticResource ColorErrorRedHover}"/>
            <SolidColorBrush x:Key="BrushErrorRedPressed"     Color="{StaticResource ColorErrorRedPressed}"/>
            <SolidColorBrush x:Key="BrushSecondaryHover"      Color="{StaticResource ColorVividRed10}"/>
            <SolidColorBrush x:Key="BrushGhostHover"          Color="{StaticResource ColorOffWhiteHover}"/>
            <SolidColorBrush x:Key="BrushDisabledBackground"  Color="{StaticResource ColorLightBorder}"/>
            <SolidColorBrush x:Key="BrushDisabledForeground"  Color="{StaticResource ColorSilverSteel}"/>
            <SolidColorBrush x:Key="BrushPrimaryForeground"   Color="{StaticResource ColorPureWhite}"/>
            <SolidColorBrush x:Key="BrushSecondaryBackground" Color="{StaticResource ColorPureWhite}"/>
            <SolidColorBrush x:Key="BrushSecondaryBorder"     Color="{StaticResource ColorVividRed}"/>
            <SolidColorBrush x:Key="BrushSecondaryForeground" Color="{StaticResource ColorVividRed}"/>
            <SolidColorBrush x:Key="BrushNeutralBackground"   Color="{StaticResource ColorOffWhite}"/>
            <SolidColorBrush x:Key="BrushNeutralForeground"   Color="{StaticResource ColorCharcoalBlack}"/>
            <SolidColorBrush x:Key="BrushNeutralBorder"       Color="{StaticResource ColorLightBorder}"/>
            <SolidColorBrush x:Key="BrushGhostForeground"     Color="{StaticResource ColorMidGrey}"/>
            <SolidColorBrush x:Key="BrushInputBackground"     Color="{StaticResource ColorPureWhite}"/>
            <SolidColorBrush x:Key="BrushInputBorder"         Color="{StaticResource ColorLightBorder}"/>
            <SolidColorBrush x:Key="BrushInputFocusBorder"    Color="{StaticResource ColorVividRed}"/>
            <SolidColorBrush x:Key="BrushTableRowHover"          Color="#FDECEA"/>
            <SolidColorBrush x:Key="BrushTableRowSelected"       Color="#FEF2F2"/>
            <SolidColorBrush x:Key="BrushSuccessBadgeBackground" Color="#DCFCE7"/>
            <SolidColorBrush x:Key="BrushSuccessBadgeText"       Color="#15803D"/>
            <SolidColorBrush x:Key="BrushErrorBadgeBackground"   Color="#FEE2E2"/>
            <SolidColorBrush x:Key="BrushErrorBadgeText"         Color="#991B1B"/>
            <SolidColorBrush x:Key="BrushInfoBadgeBackground"    Color="#DBEAFE"/>
            <SolidColorBrush x:Key="BrushInfoBadgeText"          Color="#1D4ED8"/>

            <!-- ── Elevation ── -->
            <DropShadowEffect x:Key="ElevationLevel2"
                              Color="#000000" Opacity="0.14" BlurRadius="12" ShadowDepth="4" Direction="270"/>

            <!-- ── Typography ── -->
            <FontFamily x:Key="FontSans">JetBrains Mono, Source Serif 4, Inter, Segoe UI, Calibri</FontFamily>
            <FontFamily x:Key="FontMono">JetBrains Mono, Consolas, Courier New</FontFamily>
            <sys:Double x:Key="FontSizeH2">16.5</sys:Double>
            <sys:Double x:Key="FontSizeH3">12</sys:Double>
            <sys:Double x:Key="FontSizeBody">10.5</sys:Double>
            <sys:Double x:Key="FontSizeCaption">9</sys:Double>

            <Style x:Key="TextH2OnDark" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"   Value="{StaticResource FontSizeH2}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource BrushPureWhite}"/>
            </Style>
            <Style x:Key="TextH3" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"   Value="{StaticResource FontSizeH3}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource BrushCharcoalBlack}"/>
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"   Value="{StaticResource FontSizeCaption}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource BrushMidGrey}"/>
            </Style>
            <Style x:Key="TextCaption" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"   Value="{StaticResource FontSizeCaption}"/>
                <Setter Property="Foreground" Value="{StaticResource BrushMidGrey}"/>
            </Style>

            <!-- ── Buttons ── -->
            <Style x:Key="ButtonBaseStyle" TargetType="Button">
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding"         Value="14,0"/>
                <Setter Property="Height"          Value="32"/>
                <Setter Property="FontFamily"      Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"        Value="{StaticResource FontSizeBody}"/>
                <Setter Property="FontWeight"      Value="SemiBold"/>
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="Foreground"      Value="{StaticResource BrushCharcoalBlack}"/>
                <Setter Property="BorderBrush"     Value="Transparent"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ButtonPrimary" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Background"      Value="{StaticResource BrushVividRed}"/>
                <Setter Property="Foreground"      Value="{StaticResource BrushPrimaryForeground}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushVividRedHover}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushVividRedPressed}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{StaticResource BrushDisabledBackground}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushDisabledForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ButtonSecondary" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Background"      Value="{StaticResource BrushSecondaryBackground}"/>
                <Setter Property="Foreground"      Value="{StaticResource BrushSecondaryForeground}"/>
                <Setter Property="BorderBrush"     Value="{StaticResource BrushSecondaryBorder}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushSecondaryHover}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="BorderBrush" Value="{StaticResource BrushDisabledBackground}"/>
                        <Setter Property="Foreground"  Value="{StaticResource BrushDisabledForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ButtonNeutral" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Background"  Value="{StaticResource BrushNeutralBackground}"/>
                <Setter Property="Foreground"  Value="{StaticResource BrushNeutralForeground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushNeutralBorder}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushLightBorder}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{StaticResource BrushDisabledForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ButtonGhost" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="Foreground"      Value="{StaticResource BrushGhostForeground}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushGhostHover}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{StaticResource BrushDisabledForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ── TextBox (stroke-on-top, §12.7.O) ── -->
            <Style x:Key="InputTextBox" TargetType="TextBox">
                <Setter Property="FontFamily"               Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"                 Value="{StaticResource FontSizeBody}"/>
                <Setter Property="Foreground"               Value="{StaticResource BrushCharcoalBlack}"/>
                <Setter Property="Background"               Value="{StaticResource BrushInputBackground}"/>
                <Setter Property="BorderBrush"              Value="{StaticResource BrushInputBorder}"/>
                <Setter Property="BorderThickness"          Value="1"/>
                <Setter Property="Height"                   Value="30"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid SnapsToDevicePixels="True">
                                <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="8,0" VerticalAlignment="Center"/>
                                <Border x:Name="Stroke" CornerRadius="5"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        IsHitTestVisible="False"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Stroke" Property="BorderBrush"     Value="{StaticResource BrushInputFocusBorder}"/>
                                    <Setter TargetName="Stroke" Property="BorderThickness" Value="1.5"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bg" Property="Background"  Value="{StaticResource BrushDisabledBackground}"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushDisabledForeground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── ComboBox — supports editable AND non-editable (§12.7.C) ── -->
            <Style x:Key="InputComboBox" TargetType="ComboBox">
                <Setter Property="FontFamily"               Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"                 Value="{StaticResource FontSizeBody}"/>
                <Setter Property="Foreground"               Value="{StaticResource BrushCharcoalBlack}"/>
                <Setter Property="Background"               Value="{StaticResource BrushInputBackground}"/>
                <Setter Property="BorderBrush"              Value="{StaticResource BrushInputBorder}"/>
                <Setter Property="BorderThickness"          Value="1"/>
                <Setter Property="Height"                   Value="30"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid SnapsToDevicePixels="True">
                                <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5"/>
                                <!-- Full-area toggle: click anywhere (non-editable) or the
                                     arrow (editable) opens the dropdown. -->
                                <ToggleButton x:Name="OpenToggle" Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M0,0 L4,4 L8,0"
                                                      Fill="{StaticResource BrushMidGrey}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ContentSite" Margin="8,0,24,0"
                                                  IsHitTestVisible="False" VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                <TextBox x:Name="PART_EditableTextBox" Margin="6,0,24,0"
                                         VerticalAlignment="Center" Visibility="Hidden"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource BrushCharcoalBlack}"
                                         IsReadOnly="{TemplateBinding IsReadOnly}"/>
                                <Border x:Name="Stroke" CornerRadius="5"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        IsHitTestVisible="False"/>
                                <Popup x:Name="PART_Popup" Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True" Focusable="False"
                                       PopupAnimation="Slide">
                                    <!-- min = combo width, grows to widest item (capped) -->
                                    <Border MinWidth="{TemplateBinding ActualWidth}" MaxWidth="520"
                                            BorderBrush="{StaticResource BrushLightBorder}"
                                            BorderThickness="1" CornerRadius="6"
                                            Background="{StaticResource BrushPureWhite}"
                                            Effect="{StaticResource ElevationLevel2}">
                                        <ScrollViewer MaxHeight="220" Margin="4" HorizontalScrollBarVisibility="Hidden">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEditable" Value="True">
                                    <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="ContentSite"          Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Stroke" Property="BorderBrush"     Value="{StaticResource BrushInputFocusBorder}"/>
                                    <Setter TargetName="Stroke" Property="BorderThickness" Value="1.5"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushDisabledBackground}"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushDisabledForeground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBoxItem">
                <Setter Property="FontFamily"  Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"    Value="{StaticResource FontSizeBody}"/>
                <Setter Property="Foreground"  Value="{StaticResource BrushCharcoalBlack}"/>
                <Setter Property="Background"  Value="{StaticResource BrushPureWhite}"/>
                <Setter Property="Padding"     Value="10,5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushTableRowHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushTableRowSelected}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── Toggle switch (§9.9) — targets CheckBox so IsChecked logic is unchanged ── -->
            <Style x:Key="ToggleSwitch" TargetType="CheckBox">
                <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"   Value="{StaticResource FontSizeBody}"/>
                <Setter Property="Foreground" Value="{StaticResource BrushCharcoalBlack}"/>
                <Setter Property="Cursor"     Value="Hand"/>
                <Setter Property="MinHeight"  Value="24"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                                <Border x:Name="Track" Grid.Column="1"
                                        Width="38" Height="20" CornerRadius="10"
                                        Background="{StaticResource BrushSilverSteel}"
                                        VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Ellipse x:Name="Thumb" Width="16" Height="16"
                                             Fill="{StaticResource BrushPureWhite}"
                                             HorizontalAlignment="Left" Margin="2,0,0,0">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform x:Name="ThumbShift" X="0"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background"
                                            Value="{StaticResource BrushVividRed}"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ThumbShift"
                                                                 Storyboard.TargetProperty="X"
                                                                 To="18" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ThumbShift"
                                                                 Storyboard.TargetProperty="X"
                                                                 To="0" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Track" Property="Background"
                                            Value="{StaticResource BrushDisabledBackground}"/>
                                    <Setter Property="Foreground"
                                            Value="{StaticResource BrushDisabledForeground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── Grid checkbox (DataGrid ✓ column) — own bool IsChecked drives the tick ── -->
            <Style x:Key="GridCheckBox" TargetType="CheckBox">
                <Setter Property="Cursor"              Value="Hand"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment"   Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="3"
                                    BorderBrush="{StaticResource BrushLightBorder}" BorderThickness="1"
                                    Background="{StaticResource BrushPureWhite}">
                                <Viewbox x:Name="CheckMark" Margin="3" Visibility="Collapsed">
                                    <Path Data="M0,3.5 L3.5,7 L9,0"
                                          Stroke="{StaticResource BrushPureWhite}" StrokeThickness="1.8"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Fill="Transparent"/>
                                </Viewbox>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Box" Property="Background"  Value="{StaticResource BrushVividRed}"/>
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrushVividRed}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrushVividRed}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── Tab-style RadioButton (operation modes) ── -->
            <Style x:Key="TabRadio" TargetType="RadioButton">
                <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"   Value="{StaticResource FontSizeBody}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource BrushMidGrey}"/>
                <Setter Property="Cursor"     Value="Hand"/>
                <Setter Property="Margin"     Value="0,0,18,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                    Padding="0,0,0,5">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushVividRed}"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushCharcoalBlack}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource BrushCharcoalBlack}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── ListBox item (autosuggest popup) ── -->
            <Style TargetType="ListBoxItem">
                <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"   Value="{StaticResource FontSizeBody}"/>
                <Setter Property="Foreground" Value="{StaticResource BrushCharcoalBlack}"/>
                <Setter Property="Padding"    Value="8,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushTableRowHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushTableRowSelected}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── ScrollBar (both orientations) ── -->
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Vertical">
                        <Setter Property="Width"    Value="8"/>
                        <Setter Property="MinWidth" Value="8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="Transparent">
                                        <Border Background="{StaticResource BrushOffWhite}" CornerRadius="4" Margin="2,0"/>
                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"
                                                              Opacity="0" Background="Transparent" BorderThickness="0"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"
                                                              Opacity="0" Background="Transparent" BorderThickness="0"/>
                                            </Track.IncreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb>
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border x:Name="ThumbBd" CornerRadius="3" Margin="2,0"
                                                                    Background="{StaticResource BrushSilverSteel}"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource BrushCharcoalBlack}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource BrushVividRed}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Height"    Value="8"/>
                        <Setter Property="MinHeight" Value="8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="Transparent">
                                        <Border Background="{StaticResource BrushOffWhite}" CornerRadius="4" Margin="0,2"/>
                                        <Track x:Name="PART_Track">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageLeftCommand" Focusable="False"
                                                              Opacity="0" Background="Transparent" BorderThickness="0"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageRightCommand" Focusable="False"
                                                              Opacity="0" Background="Transparent" BorderThickness="0"/>
                                            </Track.IncreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb>
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border x:Name="ThumbBd" CornerRadius="3" Margin="0,2"
                                                                    Background="{StaticResource BrushSilverSteel}"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource BrushCharcoalBlack}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource BrushVividRed}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ── Card ── -->
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background"      Value="{StaticResource BrushPureWhite}"/>
                <Setter Property="BorderBrush"     Value="{StaticResource BrushLightBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius"    Value="8"/>
                <Setter Property="Padding"         Value="16"/>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <!-- ════════════════════════════════════════════════════════════════════
         MAIN LAYOUT
         Two cards: the saved rules on the left, the rule being built on the
         right. The footer carries the status badge, the live count and the
         actions — §12.6: the header holds the title only, transient state
         lives in the footer status row.
         ════════════════════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0 header -->
            <RowDefinition Height="3"/>      <!-- 1 accent rule -->
            <RowDefinition Height="Auto"/>   <!-- 2 hint strip -->
            <RowDefinition Height="*"/>      <!-- 3 body -->
            <RowDefinition Height="Auto"/>   <!-- 4 footer -->
        </Grid.RowDefinitions>

        <!-- ── Header: the title, and the build actually running ── -->
        <Border Grid.Row="0" Background="{StaticResource BrushCharcoalBlack}" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Filter View Manager" Style="{StaticResource TextH2OnDark}"
                           VerticalAlignment="Center" />
                <Border Grid.Column="1" Background="{StaticResource BrushVividRed}" CornerRadius="3"
                        Padding="8,3" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionText" Text="0.1.0"
                               FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeCaption}"
                               FontWeight="SemiBold" Foreground="{StaticResource BrushPureWhite}"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>
        <Rectangle Grid.Row="1" Fill="{StaticResource BrushVividRed}"/>

        <!-- ── Hint strip: what this window does to the model, always visible ── -->
        <Border Grid.Row="2" Background="{StaticResource BrushOffWhite}"
                BorderBrush="{StaticResource BrushLightBorder}" BorderThickness="0,0,0,1"
                Padding="16,7">
            <TextBlock x:Name="HintText"
                       Text="Pressing a rule isolates its matches in the active view only. Nothing is written to the project."
                       Style="{StaticResource TextCaption}" TextWrapping="Wrap"/>
        </Border>

        <!-- ── Body ── -->
        <Grid Grid.Row="3" Margin="16,14,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══ LEFT: saved rules ══ -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Saved rules" Style="{StaticResource TextH3}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="RuleCountText" Text="0"
                                   Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- SelectionMode="Extended" is the whole of Ctrl+click and
                         Shift+click: WPF does both natively once the mode is
                         right, and the same mode is what cad2bim's layer
                         mapping uses. The tick is a REPORT of selection, not a
                         second way to make one - it is bound one-way to the
                         row's own IsSelected and is not hit-testable, so
                         clicking it selects the row exactly as clicking the
                         name does (section 12.7.Q: a Python bool does not
                         coerce for a checkbox, so the binding has to go to the
                         native container). -->
                    <ListBox Grid.Row="1" x:Name="RuleList"
                             Background="{StaticResource BrushPureWhite}"
                             BorderBrush="{StaticResource BrushLightBorder}" BorderThickness="1"
                             SelectionMode="Extended"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ToolTip="Your saved rules. Click one to load it into the editor. Ctrl+click adds to the selection and Shift+click takes a run of them - Duplicate, Delete and the four Move buttons act on everything ticked.">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" Style="{StaticResource GridCheckBox}"
                                              IsHitTestVisible="False"
                                              IsChecked="{Binding IsSelected, Mode=OneWay, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                              VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="1" Background="{StaticResource BrushInfoBadgeBackground}"
                                                    CornerRadius="3" Padding="6,1" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding Badge}"
                                                           FontFamily="{StaticResource FontMono}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="{StaticResource BrushInfoBadgeText}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource TextCaption}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="NewRuleBtn" Content="New"
                                    Style="{StaticResource ButtonNeutral}"
                                    ToolTip="Clear the editor and start a new rule. Nothing is saved until you press Save rule."/>
                            <Button Grid.Column="2" x:Name="DuplicateRuleBtn" Content="Duplicate"
                                    Style="{StaticResource ButtonNeutral}"
                                    ToolTip="Copy everything selected under new names, so you can change one thing without losing the original."/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="MoveUpBtn" Content="Move up"
                                    Style="{StaticResource ButtonNeutral}"
                                    ToolTip="Move everything selected up one place. The order here is the order the dockable panel draws its buttons in."/>
                            <Button Grid.Column="2" x:Name="MoveDownBtn" Content="Move down"
                                    Style="{StaticResource ButtonNeutral}"
                                    ToolTip="Move everything selected down one place."/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="MoveTopBtn" Content="To top"
                                    Style="{StaticResource ButtonNeutral}"
                                    ToolTip="Send everything selected straight to the top of the list, in one step, keeping the order it is in."/>
                            <Button Grid.Column="2" x:Name="MoveBottomBtn" Content="To bottom"
                                    Style="{StaticResource ButtonNeutral}"
                                    ToolTip="Send everything selected straight to the bottom of the list, keeping the order it is in."/>
                        </Grid>
                        <Button x:Name="DeleteRuleBtn" Content="Delete rule"
                                Style="{StaticResource ButtonGhost}"
                                ToolTip="Delete everything selected. You are asked to confirm first, and it says how many. Nothing in the model changes."/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ RIGHT: the rule being built ══ -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Build a rule" Style="{StaticResource TextH3}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="RefreshBtn" Content="Re-read model"
                                Style="{StaticResource ButtonNeutral}" Width="120"
                                ToolTip="Read the categories, families, types and parameters again. Use this after loading a family or opening a different project."/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,10,0">

                            <TextBlock Text="Rule name" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                            <TextBox x:Name="RuleNameBox" Style="{StaticResource InputTextBox}" Margin="0,0,0,12"
                                     ToolTip="What the button will be called. This is the only thing you will see on the dockable panel, so name it for what it shows."/>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Categories" Style="{StaticResource FieldLabel}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="CategoryPickedText" Text="none picked"
                                           Style="{StaticResource TextCaption}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <TextBox x:Name="CategorySearch" Style="{StaticResource InputTextBox}" Margin="0,0,0,6"
                                     ToolTip="Type to narrow the list below. The ticks you have already made are kept."/>
                            <ListBox x:Name="CategoryList" Height="150" SelectionMode="Multiple"
                                     Background="{StaticResource BrushPureWhite}"
                                     BorderBrush="{StaticResource BrushLightBorder}" BorderThickness="1"
                                     Margin="0,0,0,12"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ToolTip="Tick every category the rule should look in. A rule needs at least one.">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox Style="{StaticResource GridCheckBox}"
                                                      IsHitTestVisible="False"
                                                      IsChecked="{Binding IsSelected, Mode=OneWay, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                      VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="Family" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="FamilyCombo" Style="{StaticResource InputComboBox}" Margin="0,0,0,12"
                                      ToolTip="Optional. Leave on (any family) to match every family in the chosen categories. Basic Wall is a system family and appears here just like a loadable one."/>

                            <TextBlock Text="Type" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="TypeCombo" Style="{StaticResource InputComboBox}" Margin="0,0,0,14"
                                      ToolTip="Optional. Leave on (any type) to match every type in the chosen family."/>

                            <Border Background="{StaticResource BrushLightBorder}" Height="1" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Conditions" Style="{StaticResource TextH3}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <RadioButton x:Name="MatchAllRadio" Content="All" GroupName="MatchMode"
                                                 Style="{StaticResource TabRadio}" IsChecked="True"
                                                 ToolTip="An element must satisfy every condition."/>
                                    <RadioButton x:Name="MatchAnyRadio" Content="Any" GroupName="MatchMode"
                                                 Style="{StaticResource TabRadio}" Margin="6,0,0,0"
                                                 ToolTip="An element only has to satisfy one of the conditions."/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" x:Name="ParameterCombo" Style="{StaticResource InputComboBox}"
                                          ToolTip="Every parameter these categories carry. One marked (no view filter) still works here -- pressing a rule isolates, it does not write a Revit view filter."/>
                                <ComboBox Grid.Column="2" x:Name="OperatorCombo" Style="{StaticResource InputComboBox}"
                                          ToolTip="How the value is compared."/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="ValueBox" Style="{StaticResource InputTextBox}"
                                         ToolTip="The value to compare against. For 'is between', two numbers separated by a comma is not accepted -- use the second box. A comma is never read as a decimal point."/>
                                <ComboBox Grid.Column="2" x:Name="UnitCombo" Style="{StaticResource InputComboBox}"
                                          ToolTip="The unit you typed the value in. It is saved with the rule, so the rule still means the same thing on an imperial project."/>
                                <Button Grid.Column="4" x:Name="AddConditionBtn" Content="Add condition"
                                        Style="{StaticResource ButtonSecondary}"
                                        ToolTip="Add this condition to the rule."/>
                            </Grid>

                            <!-- The list and its Remove button share a row.
                                 Remove sat UNDER the list until 2026-09-10,
                                 which put it below the scroll fold: it was
                                 built, wired and working, and simply could not
                                 be seen. A control the user cannot find is a
                                 control that does not exist. -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>

                                <ListBox Grid.Column="0" x:Name="ConditionList"
                                         Height="96"
                                         Background="{StaticResource BrushPureWhite}"
                                         BorderBrush="{StaticResource BrushLightBorder}"
                                         BorderThickness="1"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ToolTip="The conditions on this rule. A rule with none matches everything in its categories, which is a legitimate rule. Double-click one to remove it.">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}"
                                                       FontFamily="{StaticResource FontMono}"
                                                       FontSize="{StaticResource FontSizeBody}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Button Grid.Column="2" x:Name="RemoveConditionBtn"
                                        Content="Remove" VerticalAlignment="Top"
                                        Style="{StaticResource ButtonGhost}"
                                        ToolTip="Remove the condition selected in the list. Double-clicking a condition does the same."/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="{StaticResource BrushOffWhite}" CornerRadius="5"
                            Padding="10,8" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="ProblemText" Text="Pick a category to begin."
                                       Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="SaveRuleBtn" Content="Save rule" Width="130"
                                    Style="{StaticResource ButtonPrimary}" Margin="10,0,0,0"
                                    ToolTip="Save this rule so it is here next time, and in your next project. Saved rules live in your AppData, not in the model."/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ── Footer: the badge, the live count, and the actions ── -->
        <Border Grid.Row="4" Background="{StaticResource BrushOffWhite}"
                BorderBrush="{StaticResource BrushLightBorder}" BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" x:Name="StatusBadge"
                        Background="{StaticResource BrushInfoBadgeBackground}"
                        CornerRadius="3" Padding="8,3" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock x:Name="StatusBadgeText" Text="READY"
                               FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeCaption}"
                               FontWeight="SemiBold" Foreground="{StaticResource BrushInfoBadgeText}"/>
                </Border>

                <TextBlock Grid.Column="1" x:Name="StatusBar" Text="Reading the model..."
                           FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{StaticResource BrushMidGrey}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2" x:Name="LiveCount" Text=""
                           FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeCaption}"
                           FontWeight="SemiBold" Foreground="{StaticResource BrushCharcoalBlack}"
                           VerticalAlignment="Center" Margin="12,0,14,0"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="PanelBtn" Content="Panel" Width="86"
                            Style="{StaticResource ButtonNeutral}"
                            Margin="0,0,6,0"
                            ToolTip="Show the dockable panel that holds these rules as buttons. It docks under the ribbon and can be dragged to either edge, like Properties."/>
                    <Button x:Name="CountBtn" Content="Count" Width="86" Style="{StaticResource ButtonNeutral}"
                            ToolTip="Count what this rule matches in the active view, without changing anything."/>
                    <Button x:Name="SelectBtn" Content="Select" Width="86" Style="{StaticResource ButtonNeutral}"
                            Margin="6,0,0,0"
                            ToolTip="Put the matches into Revit's selection instead of isolating them."/>
                    <Button x:Name="ClearBtn" Content="Clear" Width="86" Style="{StaticResource ButtonSecondary}"
                            Margin="6,0,0,0"
                            ToolTip="Put the view back. The same as Revit's own Reset Temporary Hide/Isolate."/>
                    <Button x:Name="ApplyBtn" Content="Apply" Width="110" Style="{StaticResource ButtonPrimary}"
                            Margin="6,0,0,0"
                            ToolTip="Isolate the matches in the active view. Temporary, this view only, and nothing is written to the project."/>
                    <Button x:Name="CloseBtn" Content="Close" Width="86" Style="{StaticResource ButtonGhost}"
                            Margin="6,0,0,0" ToolTip="Close the window. Saved rules stay saved."/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
