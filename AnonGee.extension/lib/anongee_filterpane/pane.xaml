<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             MinWidth="180" MinHeight="52"
             UseLayoutRounding="True"
             FontFamily="JetBrains Mono, Source Serif 4, Inter, Segoe UI, Calibri">

    <!-- ════════════════════════════════════════════════════════════════
         AnonGee Filter Views — the dockable pane
         ════════════════════════════════════════════════════════════════

         WHY THIS ONE IS DARK, AND GREY RATHER THAN BLACK
         Brand guidelines §3.8: a surface embedded in Revit's own chrome
         wears the dark palette, because it sits between the Properties
         palette and the Project Browser and a white slab there reads as a
         rendering fault. §3.8 also says which dark: Revit's OWN panel grey,
         not the brand's Charcoal. v3.3 tried near-black and it read as a
         hole punched between two grey palettes. Matching the host is the
         whole point of an embedded surface.

         WHY THE THEME IS INLINE AND WHAT KEEPS IT HONEST
         §12.3 strategy 2: pack:// URIs do not resolve inside Revit's
         sandbox, so the dictionary is pasted rather than merged. Every
         block below is a VERBATIM extract from Resources/Colors.xaml,
         Resources/Typography.xaml and Resources/Controls.xaml — generated
         by lifting those exact lines, and tests/test_filterpane_ui.py
         re-lifts them and fails on any difference. Do not hand-edit a style
         here; change the canonical file and re-splice.

         ONLY WHAT THE PANE USES
         A key nothing reaches is a style that can rot unnoticed. The gate
         fails on one, which is how this file stays a quarter the size of
         the dictionary it is drawn from.
         ════════════════════════════════════════════════════════════════ -->

    <UserControl.Resources>
        <ResourceDictionary>

            <!-- ── Colors (verbatim: Resources/Colors.xaml) ── -->
            <Color x:Key="ColorVividRedOnDark">#FFFF5F4C</Color>
            <Color x:Key="ColorVividRedPressed">#FFA81515</Color>
            <Color x:Key="ColorVividRed10">#1AE02020</Color>
            <Color x:Key="ColorCharcoalBlack">#FF141414</Color>
            <Color x:Key="ColorSilverSteel">#FFC0C8D8</Color>
            <Color x:Key="ColorPureWhite">#FFFFFFFF</Color>
            <Color x:Key="ColorMidGrey">#FF6B7280</Color>
            <Color x:Key="ColorDarkCanvas">#FF383838</Color>
            <Color x:Key="ColorDarkSurface">#FF434347</Color>
            <Color x:Key="ColorDarkSurfaceHover">#FF4E4E55</Color>
            <Color x:Key="ColorDarkSurfacePressed">#FF5A5A63</Color>
            <Color x:Key="ColorDarkBorder">#FF4A4A4E</Color>
            <Color x:Key="ColorDarkBorderStrong">#FF9EA1AB</Color>
            <Color x:Key="ColorDarkTextPrimary">#FFF2F3F5</Color>
            <Color x:Key="ColorDarkTextMuted">#FFB4BBC8</Color>
            <Color x:Key="ColorDarkDisabled">#FF8A8D96</Color>
            <Color x:Key="ColorSuccessGreenOnDark">#FF4ADE80</Color>
            <Color x:Key="ColorErrorRedOnDark">#FFFF9A93</Color>

            <!-- ── Brushes (verbatim: Resources/Colors.xaml) ── -->
            <SolidColorBrush x:Key="BrushVividRedOnDark"      Color="{StaticResource ColorVividRedOnDark}"/>
            <SolidColorBrush x:Key="BrushVividRedPressed"  Color="{StaticResource ColorVividRedPressed}"/>
            <SolidColorBrush x:Key="BrushSecondaryHover"   Color="{StaticResource ColorVividRed10}"/>
            <SolidColorBrush x:Key="BrushCharcoalBlack" Color="{StaticResource ColorCharcoalBlack}"/>
            <SolidColorBrush x:Key="BrushSilverSteel"   Color="{StaticResource ColorSilverSteel}"/>
            <SolidColorBrush x:Key="BrushPureWhite"     Color="{StaticResource ColorPureWhite}"/>
            <SolidColorBrush x:Key="BrushMidGrey"       Color="{StaticResource ColorMidGrey}"/>
            <SolidColorBrush x:Key="BrushDarkCanvas"          Color="{StaticResource ColorDarkCanvas}"/>
            <SolidColorBrush x:Key="BrushDarkSurface"         Color="{StaticResource ColorDarkSurface}"/>
            <SolidColorBrush x:Key="BrushDarkSurfaceHover"    Color="{StaticResource ColorDarkSurfaceHover}"/>
            <SolidColorBrush x:Key="BrushDarkSurfacePressed"  Color="{StaticResource ColorDarkSurfacePressed}"/>
            <SolidColorBrush x:Key="BrushDarkBorder"          Color="{StaticResource ColorDarkBorder}"/>
            <SolidColorBrush x:Key="BrushDarkBorderStrong"    Color="{StaticResource ColorDarkBorderStrong}"/>
            <SolidColorBrush x:Key="BrushDarkTextPrimary"     Color="{StaticResource ColorDarkTextPrimary}"/>
            <SolidColorBrush x:Key="BrushDarkTextMuted"       Color="{StaticResource ColorDarkTextMuted}"/>
            <SolidColorBrush x:Key="BrushDarkDisabled"        Color="{StaticResource ColorDarkDisabled}"/>
            <SolidColorBrush x:Key="BrushSuccessGreenOnDark"  Color="{StaticResource ColorSuccessGreenOnDark}"/>
            <SolidColorBrush x:Key="BrushErrorRedOnDark"      Color="{StaticResource ColorErrorRedOnDark}"/>

            <!-- ── Typography (verbatim: Resources/Typography.xaml) ── -->
            <FontFamily x:Key="FontSans">JetBrains Mono, Source Serif 4, Inter, Segoe UI, Calibri</FontFamily>
            <sys:Double x:Key="FontSizeBody">9.5</sys:Double>
            <sys:Double x:Key="FontSizeCaption">8.5</sys:Double>
            <Style x:Key="TextCaption" TargetType="TextBlock">
                <Setter Property="FontFamily"   Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"     Value="{StaticResource FontSizeCaption}"/>
                <Setter Property="Foreground"   Value="{StaticResource BrushMidGrey}"/>
            </Style>
            <Style x:Key="TextCaptionOnDark" BasedOn="{StaticResource TextCaption}" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource BrushDarkTextMuted}"/>
            </Style>

            <!-- ── Controls (verbatim: Resources/Controls.xaml) ── -->
            <Style x:Key="ButtonBaseStyle" TargetType="Button">
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding"         Value="12,0"/>
                <Setter Property="Height"          Value="28"/>
                <Setter Property="FontFamily"      Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"        Value="{StaticResource FontSizeBody}"/>
                <Setter Property="FontWeight"      Value="SemiBold"/>
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="Foreground"      Value="{StaticResource BrushCharcoalBlack}"/>
                <Setter Property="BorderBrush"     Value="Transparent"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ButtonSecondaryOnDark" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="Foreground"      Value="{StaticResource BrushDarkTextPrimary}"/>
                <Setter Property="BorderBrush"     Value="{StaticResource BrushVividRedOnDark}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushSecondaryHover}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background"  Value="{StaticResource BrushVividRedPressed}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushVividRedPressed}"/>
                        <Setter Property="Foreground"  Value="{StaticResource BrushPureWhite}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="BorderBrush" Value="{StaticResource BrushDarkBorder}"/>
                        <Setter Property="Foreground"  Value="{StaticResource BrushDarkDisabled}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ButtonGhostOnDark" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="Foreground"      Value="{StaticResource BrushDarkTextMuted}"/>
                <Setter Property="BorderBrush"     Value="{StaticResource BrushDarkBorderStrong}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushDarkSurfaceHover}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushDarkTextPrimary}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushDarkSurfacePressed}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="BorderBrush" Value="{StaticResource BrushDarkBorder}"/>
                        <Setter Property="Foreground"  Value="{StaticResource BrushDarkDisabled}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ButtonRuleOnDark" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Background"               Value="{StaticResource BrushDarkSurface}"/>
                <Setter Property="Foreground"               Value="{StaticResource BrushDarkTextPrimary}"/>
                <Setter Property="BorderBrush"              Value="{StaticResource BrushDarkBorderStrong}"/>
                <Setter Property="BorderThickness"          Value="1"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Accent"
                                    Background="{StaticResource BrushVividRedOnDark}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                <Border x:Name="Fill"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="0,4,4,0"
                                        Margin="3,0,0,0"
                                        Padding="{TemplateBinding Padding}">
                                    <TextBlock x:Name="Label"
                                               Text="{TemplateBinding Content}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Fill" Property="Background"
                                            Value="{StaticResource BrushDarkSurfaceHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Fill" Property="Background"
                                            Value="{StaticResource BrushDarkSurfacePressed}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Accent" Property="BorderBrush"
                                            Value="{StaticResource BrushVividRedOnDark}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Accent" Property="Background"
                                            Value="{StaticResource BrushDarkBorder}"/>
                                    <Setter TargetName="Label" Property="Foreground"
                                            Value="{StaticResource BrushDarkDisabled}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ScrollBarOnDark" TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Width"      Value="8"/>
                <Setter Property="MinWidth"   Value="8"/>
                <!-- Vertical template (default) -->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Border Background="{StaticResource BrushDarkCanvas}"
                                        CornerRadius="4" Margin="2,0"/>
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand"
                                                      Focusable="False" Opacity="0"
                                                      Background="Transparent" BorderThickness="0"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand"
                                                      Focusable="False" Opacity="0"
                                                      Background="Transparent" BorderThickness="0"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="ThumbBd"
                                                            CornerRadius="3" Margin="2,0"
                                                            Background="{StaticResource BrushDarkBorderStrong}"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbBd" Property="Background"
                                                                    Value="{StaticResource BrushSilverSteel}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="ThumbBd" Property="Background"
                                                                    Value="{StaticResource BrushVividRedOnDark}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <!-- Horizontal orientation override -->
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width"     Value="Auto"/>
                        <Setter Property="MinWidth"  Value="0"/>
                        <Setter Property="Height"    Value="8"/>
                        <Setter Property="MinHeight" Value="8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="Transparent">
                                        <Border Background="{StaticResource BrushDarkCanvas}"
                                                CornerRadius="4" Margin="0,2"/>
                                        <Track x:Name="PART_Track" IsDirectionReversed="False">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                              Focusable="False" Opacity="0"
                                                              Background="Transparent" BorderThickness="0"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageRightCommand"
                                                              Focusable="False" Opacity="0"
                                                              Background="Transparent" BorderThickness="0"/>
                                            </Track.IncreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb>
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border x:Name="ThumbBd"
                                                                    CornerRadius="3" Margin="0,2"
                                                                    Background="{StaticResource BrushDarkBorderStrong}"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ThumbBd" Property="Background"
                                                                            Value="{StaticResource BrushSilverSteel}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter TargetName="ThumbBd" Property="Background"
                                                                            Value="{StaticResource BrushVividRedOnDark}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- The one line that is not an extract, and it is a derivation
                 rather than a variant: every ScrollBar inside this pane is
                 the dark one. Keyed in Controls.xaml so opting in costs a
                 BasedOn and nothing on the canonical style moves. -->
            <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBarOnDark}"/>

        </ResourceDictionary>
    </UserControl.Resources>

    <!-- ════════════════════════════════════════════════════════════════
         LAYOUT — one DockPanel, two orientations, no second tree.

         Docked top or bottom the pane is a wide short strip: the actions
         sit at the RIGHT and the rules run ACROSS behind a horizontal
         scrollbar. Docked left or right it is narrow and tall: the actions
         move to the TOP and the rules STACK behind a vertical one. Both
         states are the same four elements — provider.py re-docks and
         re-orients them on SizeChanged. See FilterViewPane._layout.

         Everything is Top/Left aligned. A dockable pane is given whatever
         height the user dragged it to, so content that centres itself
         floats in the middle of an empty panel.
         ════════════════════════════════════════════════════════════════ -->

    <Border Background="{StaticResource BrushDarkCanvas}" Padding="6,4">
        <DockPanel LastChildFill="True">

            <!-- 2px brand rule, §12.6 DockablePanelTemplate. Docked first so
                 it stays the top edge whichever side the actions move to.
                 The LIFTED red: brand red on Revit grey is 2.46:1 and reads
                 as dull brick rather than an accent (§3.8.5). -->
            <Rectangle DockPanel.Dock="Top" Height="2"
                       Fill="{StaticResource BrushVividRedOnDark}" Margin="0,0,0,4"/>

            <!-- Actions. Dock and Orientation are both rewritten at runtime. -->
            <StackPanel x:Name="PaneActions" DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Top" Margin="6,0,0,0">
                <Button x:Name="PaneClear" Content="Clear" MinWidth="62"
                        Style="{StaticResource ButtonSecondaryOnDark}"
                        ToolTip="Put the active view back. The same as Revit's own Reset Temporary Hide/Isolate."/>
                <Button x:Name="PaneRefresh" Content="Refresh" MinWidth="70"
                        Style="{StaticResource ButtonGhostOnDark}" Margin="6,0,0,0"
                        ToolTip="Re-read the saved rules and this panel's own appearance from disk. Press it after saving a new rule in the Filter View Manager window."/>
            </StackPanel>

            <!-- Status. Always the bottom edge; it is the only thing that
                 reports what a press did, so it is never the element that
                 gets scrolled out of sight. -->
            <TextBlock x:Name="PaneStatus" DockPanel.Dock="Bottom"
                       Text="Reading the saved rules..."
                       Style="{StaticResource TextCaptionOnDark}"
                       TextTrimming="CharacterEllipsis" Margin="2,4,2,0"/>

            <ScrollViewer x:Name="PaneScroll"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollBarVisibility="Auto"
                          Padding="0,0,0,2">
                <StackPanel x:Name="PaneButtons" Orientation="Horizontal"
                            VerticalAlignment="Top" HorizontalAlignment="Left"/>
            </ScrollViewer>

        </DockPanel>
    </Border>
</UserControl>
