# --- Your Existing Rules ---
.env
__pycache__
bin
tools/_runtime_backups/*
tools/_runtime_work/*
build/
.py3_previous_swap/
installer/payload/
installer/output/
installer/prerequisites/**/*.exe

# --- Code-signing private material ---
# Public certificates/notices may be committed deliberately, but private key
# containers must never enter the repository.
*.pfx
*.p12
*.pvk
*.key
installer/signing/private/

# --- Extended Python & Caching ---
*.pyo
*.pyc
*$py.class
.pytest_cache/
.mypy_cache/

# --- Extended AI Assistant Workspaces & Logs ---
.cline/
.roo/
.cursor/
*.log

# --- System & Environment Files ---
.DS_Store
Thumbs.db
.vscode/
.idea/